# ==========================================
# Server Configuration
# ==========================================

# Port for the web interface and API
PORT=3030

# Node environment (development | production)
NODE_ENV=development

# ==========================================
# Database Configuration
# ==========================================

# Default SQLite database path when SQLite is selected
DB_PATH=./oggo.db

# Optional MySQL settings when MySQL is selected during first-run setup
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=oggo
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=oggo

# ==========================================
# Security & Encryption
# ==========================================

# Master secret key for AES encryption of stored SSH passwords and keys
# Make sure to generate a secure random string (e.g. `openssl rand -hex 32`)
ENCRYPTION_SECRET=change-me-to-a-secure-random-string

# Session secret for Express (if using session-based auth)
SESSION_SECRET=change-me-to-a-secure-session-secret

# ==========================================
# Application Settings
# ==========================================

# Default directory for log output
LOG_DIR=./logs

# Optional: Disable terminal feature (true/false)
DISABLE_TERMINAL=false

# Auto-update TLDR cache on startup (true/false)
UPDATE_TLDR_CACHE=true
